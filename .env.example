# Copy this file to .env for local development (and set the same keys in your
# hosting provider's dashboard for production — do not commit real values).

# Postgres connection string used by Prisma.
# Local:      postgresql://postgres:postgres@localhost:5432/servemade?schema=public
# Neon:       postgresql://user:password@ep-xxxx.neon.tech/servemade?sslmode=require
# Supabase:   postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Vercel Postgres: value is provided for you when you add the integration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/servemade?schema=public"

# Public site URL, used for canonical links, sitemap.ts, robots.ts and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.servemade.example"

# WhatsApp Business number in international format, no symbols (used by the FAB).
NEXT_PUBLIC_WHATSAPP_NUMBER="910000000000"
